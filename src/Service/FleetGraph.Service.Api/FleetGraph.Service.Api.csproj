<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>FleetGraph.Service.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleetGraph.Service.Application\FleetGraph.Service.Application.csproj" />
    <ProjectReference Include="..\FleetGraph.Service.Infrastructure\FleetGraph.Service.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\FleetGraph.GraphQL\FleetGraph.GraphQL.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\FleetGraph.ServiceDefaults\FleetGraph.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" />
    <PackageReference Include="HotChocolate.Subscriptions.Redis" />
    <PackageReference Include="HotChocolate.Types.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The source schema contract (exported by `dotnet run schema export`). -->
    <Content Remove="schema-settings.json" />
