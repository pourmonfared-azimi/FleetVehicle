schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

type Query {
  "Service orders with cursor pagination, filtering and sorting."
  serviceOrders(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: ServiceOrderFilterInput @cost(weight: "10")
    order: [ServiceOrderSortInput!] @cost(weight: "10")
  ): ServiceOrdersConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  serviceOrderById(id: Int!): ServiceOrder @lookup @cost(weight: "10")
  workshops(
    "Returns the first _n_ elements from the list."
    first: Int
    "Returns the elements in the list that come after the specified cursor."
    after: String
    "Returns the last _n_ elements from the list."
    last: Int
    "Returns the elements in the list that come before the specified cursor."
    before: String
    where: WorkshopFilterInput @cost(weight: "10")
    order: [WorkshopSortInput!] @cost(weight: "10")
  ): WorkshopsConnection
    @listSize(
      assumedSize: 50
      slicingArguments: ["first", "last"]
      slicingArgumentDefaultValue: 10
      sizedFields: ["edges", "nodes"]
      requireOneSlicingArgument: false
    )
    @cost(weight: "10")
  workshopById(id: Int!): Workshop @lookup @cost(weight: "10")
  vehicleById(id: Int!): Vehicle @lookup @internal
  partById(id: Int!): Part @lookup @internal
}

type Mutation {
  createServiceOrder(input: CreateServiceOrderInput!): CreateServiceOrderPayload!
    @authorize(policy: "CanManageServiceOrders")
    @cost(weight: "10")
  updateServiceOrderStatus(input: UpdateServiceOrderStatusInput!): UpdateServiceOrderStatusPayload!
    @authorize(policy: "CanManageServiceOrders")
    @cost(weight: "10")
}

type Subscription {
  serviceOrderStatusChanged: ServiceOrderStatusChangedEvent!
}

type CreateServiceOrderPayload {
  serviceOrder: ServiceOrder
  errors: [CreateServiceOrderError!]
}

type InvalidServiceOrderStatusTransitionError implements UserError {
  from: ServiceOrderStatus!
  to: ServiceOrderStatus!
  code: String!
  message: String!
}

"Information about pagination in a connection."
type PageInfo @shareable {
  "Indicates whether more edges exist following the set defined by the clients arguments."
  hasNextPage: Boolean!
  "Indicates whether more edges exist prior the set defined by the clients arguments."
  hasPreviousPage: Boolean!
  "When paginating backwards, the cursor to continue."
  startCursor: String
  "When paginating forwards, the cursor to continue."
  endCursor: String
}

type Part @key(fields: "id") {
  id: Int!
}

"A workshop visit for one vehicle. Owning subgraph: Service."
type ServiceOrder @key(fields: "id") {
  vehicle: Vehicle!
  workshop: Workshop @cost(weight: "10")
  lines: [ServiceOrderLine!]!
    @listSize(assumedSize: 20, requireOneSlicingArgument: false)
    @cost(weight: "10")
  id: Int!
  description: String!
  status: ServiceOrderStatus!
  scheduledAt: DateTime!
  createdAt: DateTime!
  completedAt: DateTime
}

"A part needed for a service order."
type ServiceOrderLine {
  part: Part!
  id: Int!
  quantity: Int!
}

type ServiceOrderNotFoundError implements UserError {
  serviceOrderId: Int!
  code: String!
  message: String!
}

type ServiceOrderStatusChangedEvent {
  serviceOrder: ServiceOrder @cost(weight: "10")
  vehicle: Vehicle!
  previousStatus: ServiceOrderStatus!
  newStatus: ServiceOrderStatus!
  changedAt: DateTime!
}

type ServiceOrderValidationError implements UserError {
  "The input field that failed validation."
  field: String!
  code: String!
  message: String!
}

"A connection to a list of items."
type ServiceOrdersConnection @shareable {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [ServiceOrdersEdge!]
  "A flattened list of the nodes."
  nodes: [ServiceOrder!]
  "Identifies the total count of items in the connection."
  totalCount: Int! @cost(weight: "10")
}

"An edge in a connection."
type ServiceOrdersEdge @shareable {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: ServiceOrder!
}

type UpdateServiceOrderStatusPayload {
  serviceOrder: ServiceOrder
  errors: [UpdateServiceOrderStatusError!]
}

type Vehicle @key(fields: "id") {
  "Service orders for this vehicle, newest first. Contributed by the Service subgraph."
  serviceOrders(onlyOpen: Boolean! = false): [ServiceOrder!]!
    @listSize(assumedSize: 10, requireOneSlicingArgument: false)
    @cost(weight: "10")
  id: Int!
}

"A workshop that performs service orders. Owning subgraph: Service."
type Workshop @key(fields: "id") {
  id: Int!
  name: String!
  city: String!
  "Number of service bays (parallel capacity)."
  bays: Int!
}

type WorkshopNotFoundError implements UserError {
  workshopId: Int!
  code: String!
  message: String!
}

"A connection to a list of items."
type WorkshopsConnection @shareable {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [WorkshopsEdge!]
  "A flattened list of the nodes."
  nodes: [Workshop!]
  "Identifies the total count of items in the connection."
  totalCount: Int! @cost(weight: "10")
}

"An edge in a connection."
type WorkshopsEdge @shareable {
  "A cursor for use in pagination."
  cursor: String!
  "The item at the end of the edge."
  node: Workshop!
}

interface UserError {
  message: String!
  code: String!
}

union CreateServiceOrderError =
  | WorkshopNotFoundError
  | ServiceOrderValidationError

union UpdateServiceOrderStatusError =
  | ServiceOrderNotFoundError
  | InvalidServiceOrderStatusTransitionError

input CreateServiceOrderInput {
  vehicleId: Int!
  workshopId: Int!
  description: String!
  scheduledAt: DateTime!
  lines: [ServiceOrderLineInput!]!
}

input DateTimeOperationFilterInput {
  eq: DateTime @cost(weight: "10")
  neq: DateTime @cost(weight: "10")
  in: [DateTime] @cost(weight: "10")
  nin: [DateTime] @cost(weight: "10")
  gt: DateTime @cost(weight: "10")
  ngt: DateTime @cost(weight: "10")
  gte: DateTime @cost(weight: "10")
  ngte: DateTime @cost(weight: "10")
  lt: DateTime @cost(weight: "10")
  nlt: DateTime @cost(weight: "10")
  lte: DateTime @cost(weight: "10")
  nlte: DateTime @cost(weight: "10")
}

input IntOperationFilterInput {
  eq: Int @cost(weight: "10")
  neq: Int @cost(weight: "10")
  in: [Int] @cost(weight: "10")
  nin: [Int] @cost(weight: "10")
  gt: Int @cost(weight: "10")
  ngt: Int @cost(weight: "10")
  gte: Int @cost(weight: "10")
  ngte: Int @cost(weight: "10")
  lt: Int @cost(weight: "10")
  nlt: Int @cost(weight: "10")
  lte: Int @cost(weight: "10")
  nlte: Int @cost(weight: "10")
}

"A workshop visit for one vehicle. Owning subgraph: Service."
input ServiceOrderFilterInput {
  and: [ServiceOrderFilterInput!]
  or: [ServiceOrderFilterInput!]
  id: IntOperationFilterInput
  description: StringOperationFilterInput
  status: ServiceOrderStatusOperationFilterInput
  scheduledAt: DateTimeOperationFilterInput
  createdAt: DateTimeOperationFilterInput
  completedAt: DateTimeOperationFilterInput
}

"A part and quantity to reserve for a service order."
input ServiceOrderLineInput {
  partId: Int!
  quantity: Int!
}

"A workshop visit for one vehicle. Owning subgraph: Service."
input ServiceOrderSortInput {
  id: SortEnumType @cost(weight: "10")
  description: SortEnumType @cost(weight: "10")
  status: SortEnumType @cost(weight: "10")
  scheduledAt: SortEnumType @cost(weight: "10")
  createdAt: SortEnumType @cost(weight: "10")
  completedAt: SortEnumType @cost(weight: "10")
}

input ServiceOrderStatusOperationFilterInput {
  eq: ServiceOrderStatus @cost(weight: "10")
  neq: ServiceOrderStatus @cost(weight: "10")
  in: [ServiceOrderStatus!] @cost(weight: "10")
  nin: [ServiceOrderStatus!] @cost(weight: "10")
}

input StringOperationFilterInput {
  and: [StringOperationFilterInput!]
  or: [StringOperationFilterInput!]
  eq: String @cost(weight: "10")
  neq: String @cost(weight: "10")
  contains: String @cost(weight: "20")
  ncontains: String @cost(weight: "20")
  in: [String] @cost(weight: "10")
  nin: [String] @cost(weight: "10")
  startsWith: String @cost(weight: "20")
  nstartsWith: String @cost(weight: "20")
  endsWith: String @cost(weight: "20")
  nendsWith: String @cost(weight: "20")
}

input UpdateServiceOrderStatusInput {
  serviceOrderId: Int!
  status: ServiceOrderStatus!
}

"A workshop that performs service orders. Owning subgraph: Service."
input WorkshopFilterInput {
  and: [WorkshopFilterInput!]
  or: [WorkshopFilterInput!]
  id: IntOperationFilterInput
  name: StringOperationFilterInput
  city: StringOperationFilterInput
  "Number of service bays (parallel capacity)."
  bays: IntOperationFilterInput
}

"A workshop that performs service orders. Owning subgraph: Service."
input WorkshopSortInput {
  id: SortEnumType @cost(weight: "10")
  name: SortEnumType @cost(weight: "10")
  city: SortEnumType @cost(weight: "10")
  "Number of service bays (parallel capacity)."
  bays: SortEnumType @cost(weight: "10")
}

"Defines when a policy shall be executed."
enum ApplyPolicy {
  "Before the resolver was executed."
  BEFORE_RESOLVER
  "After the resolver was executed."
  AFTER_RESOLVER
  "The policy is applied in the validation step before the execution."
  VALIDATION
}

enum ScalarSerializationType {
  STRING
  BOOLEAN
  INT
  FLOAT
  OBJECT
  LIST
}

enum ServiceOrderStatus {
  SCHEDULED
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CANCELLED
}

enum SortEnumType {
  ASC
  DESC
}

"The `DateTime` scalar type represents a date and time with time zone offset information."
scalar DateTime
  @serializeAs(
    type: STRING
    pattern: "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,9})?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
  )
  @specifiedBy(url: "https://scalars.graphql.org/chillicream/date-time.html")

scalar FieldSelectionSet

"The authorize directive."
directive @authorize(
  "The name of the authorization policy that determines access to the annotated resource."
  policy: String
  "Roles that are allowed to access the annotated resource."
  roles: [String!]
  "Defines when the authorize directive shall be applied. By default the authorize directive is applied before the resolver is executed."
  apply: ApplyPolicy! = BEFORE_RESOLVER
) repeatable on OBJECT | FIELD_DEFINITION

"The purpose of the `cost` directive is to define a `weight` for GraphQL types, fields, and arguments. Static analysis can use these weights when calculating the overall cost of a query or response."
directive @cost(
  "The `weight` argument defines what value to add to the overall cost for every appearance, or possible appearance, of a type, field, argument, etc."
  weight: String!
) on
  | SCALAR
  | OBJECT
  | FIELD_DEFINITION
  | ARGUMENT_DEFINITION
  | ENUM
  | INPUT_FIELD_DEFINITION

directive @internal on OBJECT | FIELD_DEFINITION

"""
The @key directive is used to designate an entity's unique key,
which identifies how to uniquely reference an instance of
an entity across different source schemas.
"""
directive @key("The field selection set syntax." fields: FieldSelectionSet!) repeatable on
  | OBJECT
  | INTERFACE

"The purpose of the `@listSize` directive is to either inform the static analysis about the size of returned lists (if that information is statically available), or to point the analysis to where to find that information."
directive @listSize(
  "The `assumedSize` argument can be used to statically define the maximum length of a list returned by a field."
  assumedSize: Int
  "The `slicingArguments` argument can be used to define which of the field's arguments with numeric type are slicing arguments, so that their value determines the size of the list returned by that field. It may specify a list of multiple slicing arguments."
  slicingArguments: [String!]
  "The `slicingArgumentDefaultValue` argument can be used to define a default value for a slicing argument, which is used if the argument is not present in a query."
  slicingArgumentDefaultValue: Int
  "The `sizedFields` argument can be used to define that the value of the `assumedSize` argument or of a slicing argument does not affect the size of a list returned by a field itself, but that of a list returned by one of its sub-fields."
  sizedFields: [String!]
  "The `requireOneSlicingArgument` argument can be used to inform the static analysis that it should expect that exactly one of the defined slicing arguments is present in a query. If that is not the case (i.e., if none or multiple slicing arguments are present), the static analysis may throw an error."
  requireOneSlicingArgument: Boolean = true
) on FIELD_DEFINITION

"""
The @lookup directive is used within a source schema to specify output fields
that can be used by the distributed GraphQL executor to resolve an entity by
a stable key.
"""
directive @lookup on FIELD_DEFINITION

directive @serializeAs(
  "The primitive type a scalar is serialized to."
  type: [ScalarSerializationType!]!
  "The ECMA-262 regex pattern that the serialized scalar value conforms to."
  pattern: String
) on SCALAR

directive @shareable repeatable on OBJECT | FIELD_DEFINITION
