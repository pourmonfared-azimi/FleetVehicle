{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Fusion": {
    "ArchivePath": "gateway.far"
  },
  "TrustedDocuments": {
    "Path": "trusted-documents",
    "Enforce": false
  },
  "Jwt": {
    "Issuer": "fleetgraph-dev",
    "Audience": "fleetgraph",
    "SigningKey": "fleetgraph-dev-signing-key-change-me-0123456789",
    "EnableDevTokenEndpoint": false
  }
}
