<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-cutting host concerns shared by every service (gateway + subgraphs):
    OpenTelemetry, JWT authentication, authorization policies and health checks.
    Same idea as .NET Aspire "ServiceDefaults", without requiring Aspire.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
</Project>
